generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Non più usata: si accede solo con Google. Resta per gli account nati prima.
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())

  sessions       Session[]
  folders        Folder[]
  slots          TimetableSlot[]
  plans          LessonPlan[]
  phaseTemplates PhaseTemplate[]
  settings       UserSettings?
  verbs          Verb[]
  schoolYears    SchoolYear[]
  holidays       Holiday[]
  events         Event[]
  apiTokens      ApiToken[]
  exercises      Exercise[]

  googleAccount     GoogleAccount?
  materialFolders   MaterialFolder[]       @relation("FolderOwner")
  foldersCreated    MaterialFolder[]       @relation("FolderCreator")
  folderMemberships MaterialFolderMember[]
  invitesSent       FolderInvite[]
  notifications     Notification[]
  uploadedExercises Exercise[]             @relation("ExerciseUploader")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Folder {
  id           String   @id @default(cuid())
  userId       String
  parentId     String?
  name         String
  color        String   @default("slate")
  order        Int      @default(0)
  // Cartella creata per un anno scolastico ("Anno 2027/2028"): i piani copiati qui
  // dentro (anche in sottocartelle) vengono riportati in quell'anno.
  schoolYearId String?
  createdAt    DateTime @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]     @relation("FolderTree")
  plans      LessonPlan[]
  schoolYear SchoolYear?  @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// Una lezione ricorrente dell'orario settimanale del docente.
model TimetableSlot {
  id        String  @id @default(cuid())
  userId    String
  weekday   Int // 1 = lunedì ... 7 = domenica
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  subject   String
  className String  @default("")
  room      String  @default("")
  color     String  @default("blue")
  // Periodo di validità ("YYYY-MM-DD", estremi inclusi). Vuoto = sempre.
  validFrom String?
  validTo   String?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans      PlanSlot[]
  exceptions LessonException[]

  @@index([userId])
}

model LessonPlan {
  id       String  @id @default(cuid())
  userId   String
  folderId String?

  title          String  @default("")
  date           String? // "YYYY-MM-DD"
  // Senza lezioni collegate: ora di inizio (facoltativa) e durata dichiarata in minuti.
  manualStart    String?
  manualDuration Int?

  prerequisiti           String  @default("")
  obiettivoInsegnamento  String  @default("")
  traguardo              String  @default("")
  obiettivoApprendimento String  @default("")
  verifica               String  @default("")
  allegati               String  @default("")
  allegatiAuto           Boolean @default(true)
  sezioniExtra           String  @default("[]") // JSON: [{ id, titolo, testo }]
  // Dopo la lezione: com'è andata, cosa riprendere. Compare nella lezione successiva della classe.
  notaPost               String  @default("")
  // Obiettivi strutturati, JSON: [{ id, verbo, testo }]. Se presenti, i campi di testo
  // obiettivoInsegnamento / obiettivoApprendimento vengono generati da qui.
  obiettiviInsJson       String  @default("[]")
  obiettiviAppJson       String  @default("[]")

  isTemplate Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  phases    Phase[]
  slots     PlanSlot[]
  versions  PlanVersion[]
  exercises PlanExercise[]

  @@index([userId, date])
  @@index([userId, folderId])
}

model PlanSlot {
  planId String
  slotId String

  plan LessonPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  slot TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([planId, slotId])
}

model Phase {
  id                 String @id @default(cuid())
  planId             String
  order              Int
  name               String @default("")
  modality           String @default("")
  durationMin        Int    @default(5)
  obiettiviSpecifici String @default("")
  descrizione        String @default("")
  prodottoAtteso     String @default("")
  materiale          String @default("")

  plan LessonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model PhaseTemplate {
  id          String @id @default(cuid())
  userId      String
  name        String
  modality    String @default("")
  durationMin Int    @default(5)
  order       Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlanVersion {
  id        String   @id @default(cuid())
  planId    String
  snapshot  String // JSON del piano con le fasi
  createdAt DateTime @default(now())

  plan LessonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

model UserSettings {
  userId        String  @id
  lessonMinutes Int     @default(45) // durata di un'ora di lezione
  defaultHours  Int     @default(1) // ore proposte per una nuova lezione
  aiProvider    String  @default("") // "anthropic" | "google" | "openai"
  aiModel       String  @default("")
  aiKeysEnc     String  @default("") // JSON cifrato: { anthropic?, google?, openai? }
  calendarsEnc  String  @default("") // JSON cifrato: [{ id, name, url, asHolidays }]
  seeded        Boolean @default(false) // verbi e anno scolastico iniziali già creati

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Verbi consentiti per scrivere gli obiettivi.
model Verb {
  id     String @id @default(cuid())
  userId String
  kind   String // "insegnamento" | "apprendimento"
  text   String
  order  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model SchoolYear {
  id        String @id @default(cuid())
  userId    String
  name      String
  startDate String // "YYYY-MM-DD"
  endDate   String

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folders Folder[]

  @@index([userId])
}

model Holiday {
  id        String @id @default(cuid())
  userId    String
  name      String
  startDate String
  endDate   String // incluso

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Modifica di una lezione ricorrente valida per un solo giorno.
model LessonException {
  id        String  @id @default(cuid())
  slotId    String
  date      String // "YYYY-MM-DD"
  kind      String // "annullata" | "modificata"
  startTime String?
  endTime   String?
  room      String?
  note      String  @default("")

  slot TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, date])
}

// Evento di un singolo giorno (gita, giornata speciale...).
model Event {
  id             String  @id @default(cuid())
  userId         String
  title          String
  date           String // primo giorno
  endDate        String? // ultimo giorno (incluso) se l'evento dura più giorni; vuoto = un giorno solo
  startTime      String? // senza orari = giornata intera; con più giorni l'orario vale ogni giorno
  endTime        String?
  kind           String  @default("altro") // "gita" | "altro"
  color          String  @default("amber")
  note           String  @default("")
  // Classe coinvolta ("" = tutte) e se le sue lezioni in quei giorni (o in quegli orari) non si tengono.
  className      String  @default("")
  cancelsLessons Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// Token per usare le API senza sessione (Authorization: Bearer ...) o per il link del calendario.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String // primi caratteri, per riconoscerlo nell'elenco
  scope      String // "read" | "write" | "feed"
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Esercizio caricato come file (PDF, Word, Excel, PowerPoint, immagini…). Si collega a zero, uno o più piani (e un piano a zero o più esercizi).
// Il file sta nel database: il deploy conserva solo la cartella data/ con il database.
model Exercise {
  id           String   @id @default(cuid())
  userId       String
  title        String
  fileName     String
  mimeType     String   @default("application/pdf")
  size         Int
  note         String   @default("")
  createdAt    DateTime @default(now())
  // Su Google Drive: la cartella di esercizi, il file su Drive e chi l'ha caricato.
  // userId è il proprietario della cartella (sul suo Drive c'è il file).
  // Senza folderId è un file caricato sul sito prima di Drive, salvato in ExerciseFile.
  folderId     String?
  driveFileId  String?
  webViewLink  String?
  uploadedById String?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation("ExerciseUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  file       ExerciseFile?
  plans      PlanExercise[]

  @@index([userId])
  @@index([folderId])
}

// Il contenuto del file, a parte: gli elenchi non lo caricano mai.
model ExerciseFile {
  exerciseId String @id
  data       Bytes

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model PlanExercise {
  planId     String
  exerciseId String
  createdAt  DateTime @default(now())

  plan     LessonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([planId, exerciseId])
  @@index([exerciseId])
}

// L'account Google con cui l'utente accede. Il refresh token serve per usare Drive
// anche quando l'utente non è collegato (es. un collega carica nella sua cartella condivisa).
model GoogleAccount {
  userId          String   @id
  sub             String   @unique // id stabile dell'account Google
  email           String
  refreshTokenEnc String   @default("") // cifrato con APP_SECRET
  scopes          String   @default("") // permessi concessi, separati da spazio
  driveRootId     String? // cartella "PianoStudio" sul suo Drive
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Cartella di esercizi: una cartella sul Google Drive del proprietario, condivisibile.
model MaterialFolder {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  driveFolderId String
  isDefault     Boolean  @default(false) // "I miei esercizi"
  createdAt     DateTime @default(now())
  // Sottocartelle: parentId è la cartella che la contiene, rootId la cartella principale
  // (null per le cartelle principali). Si condivide solo la principale: membri e inviti
  // stanno lì e valgono per tutto ciò che contiene. ownerId è sempre il proprietario
  // della principale (tutto sta sul suo Drive); createdById chi ha creato la sottocartella.
  parentId      String?
  rootId        String?
  createdById   String?

  owner       User                   @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy   User?                  @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parent      MaterialFolder?        @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    MaterialFolder[]       @relation("FolderChildren")
  root        MaterialFolder?        @relation("FolderTree", fields: [rootId], references: [id], onDelete: Cascade)
  descendants MaterialFolder[]       @relation("FolderTree")
  members     MaterialFolderMember[]
  invites     FolderInvite[]
  exercises   Exercise[]

  @@index([ownerId])
  @@index([parentId])
  @@index([rootId])
}

model MaterialFolderMember {
  folderId          String
  userId            String
  drivePermissionId String   @default("")
  joinedAt          DateTime @default(now())

  folder MaterialFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
  @@index([userId])
}

model FolderInvite {
  id          String    @id @default(cuid())
  folderId    String
  inviterId   String
  email       String // email Google invitata, minuscola
  status      String    @default("pending") // "pending" | "accepted" | "declined" | "revoked"
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  folder  MaterialFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  inviter User           @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([folderId])
}

// Avvisi per l'utente (es. "X ha accettato il tuo invito"). Gli inviti in attesa si leggono
// direttamente da FolderInvite.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  data      String    @default("{}") // JSON
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
