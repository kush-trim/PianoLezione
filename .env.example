# Copia questo file in .env
DATABASE_URL="file:./dev.db"
# Chiave per cifrare i dati riservati (token di Google, chiavi AI, link dei calendari). Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# Accesso con Google (obbligatorio: è l'unico modo di entrare).
# Google Cloud → API e servizi → Credenziali → ID client OAuth "Applicazione web".
# URI di reindirizzamento: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Indirizzo pubblico del sito (in sviluppo: http://localhost:3000)
APP_URL="http://localhost:3000"

# Solo per le prove in locale, mai in produzione:
# DEV_LOGIN=1 abilita POST /api/auth/dev-login (accesso senza Google)
# DRIVE_FAKE=1 simula Google Drive in memoria
